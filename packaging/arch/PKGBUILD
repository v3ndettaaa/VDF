# Maintainer: VDF contributors <v3ndettaaa@users.noreply.github.com>
# VDF — professional native desktop PDF editor (Rust + Tauri v2 + MuPDF from M1)
# This is the native Arch package (makepkg -> .pkg.tar.zst).
# AppImage is NOT the Arch deliverable (MASTER_PLAN.md §15).

pkgname=vdf
pkgver=0.1.0
pkgrel=1
pkgdesc="Professional native desktop PDF editor"
arch=(x86_64)
url="https://github.com/v3ndettaaa/VDF"
license=(AGPL-3.0-only)
depends=(webkit2gtk-4.1 gtk3 hicolor-icon-theme)
makedepends=(git rust nodejs npm clang)
provides=(${pkgname})
conflicts=(${pkgname})
source=("${pkgname}::git+${url}.git")
sha256sums=(SKIP)

# In CI the checkout is the working tree; makepkg needs a source dir.
# Use the checkout directly when ./src is absent (CI) so the same PKGBUILD
# works locally and in CI.
prepare() {
  if [ ! -d "${srcdir}/${pkgname}" ]; then
    mkdir -p "${srcdir}/${pkgname}"
    cp -r "$startdir"/. "${srcdir}/${pkgname}/"
    rm -rf "${srcdir}/${pkgname}/.git"
  fi
  cd "${srcdir}/${pkgname}"

  # Frontend dependencies
  npm ci --no-audit --no-fund

  # Derive version from git when building outside a tag
  local gitver
  gitver=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//') || gitver=""
  if [ -n "$gitver" ]; then
    echo "$gitver" > .pkgver
  else
    echo "$pkgver" > .pkgver
  fi
}

build() {
  cd "${srcdir}/${pkgname}"
  export NODE_ENV=production
  npm run tauri build -- --no-bundle
}

package() {
  cd "${srcdir}/${pkgname}"

  local ver
  ver=$(cat .pkgver)

  install -Dm755 "target/release/vdf-app" "${pkgdir}/usr/bin/vdf"

  # Desktop integration (icons come with the bundler assets in M8 polish)
  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/vdf.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=VDF
GenericName=PDF Editor
Comment=Professional native desktop PDF editor
Exec=/usr/bin/vdf %F
Terminal=false
Categories=Office;Graphics;
MimeType=application/pdf;
EOF
}
